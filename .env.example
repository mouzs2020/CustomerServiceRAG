# CustomerServiceRAG 环境变量示例。
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）。
# scripts/start_web.ps1 只加载下方白名单中的变量，且进程环境变量优先于本文件。

# DeepSeek API Key（必填；请填入真实密钥，保持为空会被判定为未设置）
DEEPSEEK_API_KEY=

# 意图分类模型（可选，留空取代码默认 deepseek-v4-flash）
DEEPSEEK_INTENT_MODEL=

# 回答生成模型（可选，留空取代码默认 deepseek-v4-flash）
DEEPSEEK_MODEL=

# 意图置信度阈值，取值 [0, 1]（可选，默认 0.8）
INTENT_CONFIDENCE_THRESHOLD=0.8

# Evidence Gate rerank 分数阈值，必须是有限数字（可选，默认 0.75；rerank 分数可能大于 1）
MIN_RERANK_SCORE=0.75

# 可选验收开关（1=启用，默认不设即跳过）：
# RAG_P0_ONLINE=1   真实调用 DeepSeek 的在线验收
# RAG_P0_HEAVY=1    加载真实 Embedding / Reranker 的重型验收
# RAG_P0_ONLINE=
# RAG_P0_HEAVY=
